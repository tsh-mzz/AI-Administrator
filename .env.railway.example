# ── Paste these into Railway dashboard → service → Variables ──
# Set the SAME vars on all three services: web, celery-worker, celery-beat

# Django
SECRET_KEY=                         # python -c "import secrets; print(secrets.token_hex(50))"
DJANGO_SETTINGS_MODULE=config.settings.prod

# These are auto-provided by Railway plugins — DO NOT set manually:
# DATABASE_URL=postgresql://...     (PostgreSQL plugin injects this)
# REDIS_URL=redis://...             (Redis plugin injects this)

# AI — Groq is used by default (free, no key cost)
GROQ_API_KEY=
ANTHROPIC_API_KEY=                  # leave empty when using Groq
OPENAI_API_KEY=                     # only needed later for RAG/knowledge-base embeddings

# Encryption key for salon credentials (telegram tokens, yclients keys)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Sentry (optional — add DSN for error tracking in production)
#SENTRY_DSN=

# Qdrant — leave empty for now, bot works without it
# QDRANT_HOST=
# QDRANT_PORT=6333
# QDRANT_COLLECTION=knowledge

# Custom domain (optional — only needed if you add a domain beyond *.up.railway.app)
# ALLOWED_HOSTS=yourdomain.com
